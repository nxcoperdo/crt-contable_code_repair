PORT=4300
NODE_ENV=production
DATA_DIR=./data
ADMIN_USER=nico
ADMIN_PASS=cambia-esta-clave
SESSION_SECRET=genera-con-openssl-rand-hex-32

# Tarea programada de suscripciones y recordatorios (clave para /api/cron/*)
CRON_SECRET=genera-con-openssl-rand-hex-32

# Bot de Telegram: copia off-site del backup (scripts/backup.sh) y resumen diario
# de cartera (/api/cron/recordatorios). Crea el bot con @BotFather y saca el chat_id
# hablándole y mirando https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_TOKEN=
TELEGRAM_CHAT=

# Días de anticipación para avisar cobros/pagos por vencer en el resumen de Telegram
# (además de todo lo que ya esté vencido). Por defecto 3.
RECORDATORIOS_DIAS_ANTES=3

# Poner en 1 solo si la app está detrás de nginx (para leer la IP real del cliente)
TRUST_PROXY=

# Zona horaria con la que se fechan los movimientos (por defecto America/Bogota)
ZONA_HORARIA=America/Bogota
